---
permalink: /en/contact/
title: Contact
trUrl: /tr/iletisim/
enUrl: /en/contact/
---
{% set s = strings[lang] %}

<section class="section">
  <div class="container">
    <div class="section-title">
      <h1>{{ s.contact.title }}</h1>
      <p>{{ s.contact.subtitle }}</p>
    </div>

    <div class="contact-grid">
      <form name="contact-en" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" action="/en/contact/?success=1">
        <input type="hidden" name="form-name" value="contact-en">
        <input type="hidden" name="lang" value="en">
        <p style="display:none;"><label>Bot field: <input name="bot-field"></label></p>

        <div class="form-field">
          <label for="name-en">{{ s.contact.formName }}</label>
          <input type="text" name="name" id="name-en" required>
        </div>
        <div class="form-field">
          <label for="email-en">{{ s.contact.formEmail }}</label>
          <input type="email" name="email" id="email-en" required>
        </div>
        <div class="form-field">
          <label for="subject-en">{{ s.contact.formSubject }}</label>
          <input type="text" name="subject" id="subject-en">
        </div>
        <div class="form-field">
          <label for="message-en">{{ s.contact.formMessage }}</label>
          <textarea name="message" id="message-en" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">{{ s.cta.sendMessage }}</button>
      </form>

      <aside class="contact-info">
        <h3>{{ s.contact.directContact }}</h3>
        <dl>
          <dt>Email</dt>
          <dd><a href="mailto:{{ site.email }}">{{ site.email }}</a></dd>
          <dt>Phone</dt>
          <dd><a href="tel:{{ site.phoneRaw }}">{{ site.phone }}</a></dd>
          <dt>Location</dt>
          <dd>{{ site.location.en }}</dd>
          {% if site.social.linkedin %}
          <dt>LinkedIn</dt>
          <dd><a href="{{ site.social.linkedin }}" target="_blank" rel="noopener">{{ site.social.linkedin | replace("https://www.", "") }}</a></dd>
          {% endif %}
          {% if site.social.github %}
          <dt>GitHub</dt>
          <dd><a href="{{ site.social.github }}" target="_blank" rel="noopener">{{ site.social.github | replace("https://", "") }}</a></dd>
          {% endif %}
        </dl>
      </aside>
    </div>
  </div>
</section>
