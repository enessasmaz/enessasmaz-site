<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline[lang] }}{% endif %}</title>
  <meta name="description" content="{{ description or site.intro[lang] }}">

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="tr" href="{{ site.url }}{{ trUrl or '/tr/' }}">
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ enUrl or '/en/' }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/tr/">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}">
  <meta property="og:description" content="{{ description or site.intro[lang] }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="{% if lang == 'tr' %}tr_TR{% else %}en_US{% endif %}">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preconnect" href="https://rsms.me/">
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
  <link rel="stylesheet" href="/assets/css/style.css">

  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg">
</head>
<body>
  {% include "partials/nav.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script src="/assets/js/main.js" defer></script>
</body>
</html>
