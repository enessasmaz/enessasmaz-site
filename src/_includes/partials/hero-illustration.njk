<div class="hero-illustration" aria-hidden="true">
  <svg viewBox="0 0 460 380" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Data analytics dashboard illustration">
    <defs>
      <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#e6f0fb" stop-opacity="0.6"/>
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="barGrad" x1="0%" y1="100%" x2="0%" y2="0%">
        <stop offset="0%" stop-color="#0066cc"/>
        <stop offset="100%" stop-color="#3b8fdb"/>
      </linearGradient>
    </defs>

    <!-- Background subtle gradient blob -->
    <circle cx="380" cy="100" r="180" fill="url(#bgGrad)"/>

    <!-- Small floating data nodes (background) -->
    <g opacity="0.55">
      <circle cx="50" cy="40" r="4" fill="#0066cc"/>
      <circle cx="100" cy="20" r="3" fill="#0066cc" opacity="0.7"/>
      <circle cx="160" cy="50" r="3" fill="#0066cc" opacity="0.5"/>
      <line x1="50" y1="40" x2="100" y2="20" stroke="#0066cc" stroke-width="1.2" opacity="0.4"/>
      <line x1="100" y1="20" x2="160" y2="50" stroke="#0066cc" stroke-width="1.2" opacity="0.4"/>
    </g>

    <!-- Main dashboard card -->
    <g transform="translate(40, 60)">
      <rect x="0" y="0" width="380" height="290" rx="14" fill="#ffffff" stroke="#e5e7eb" stroke-width="1.5"/>

      <!-- Window header -->
      <rect x="0" y="0" width="380" height="36" rx="14" fill="#fafbfc"/>
      <rect x="0" y="22" width="380" height="14" fill="#fafbfc"/>
      <line x1="0" y1="36" x2="380" y2="36" stroke="#e5e7eb" stroke-width="1"/>
      <circle cx="16" cy="18" r="4" fill="#ff5f57"/>
      <circle cx="32" cy="18" r="4" fill="#febc2e"/>
      <circle cx="48" cy="18" r="4" fill="#28c840"/>
      <rect x="160" y="13" width="80" height="10" rx="3" fill="#e5e7eb"/>

      <!-- KPI cards row -->
      <g transform="translate(20, 56)">
        <rect x="0" y="0" width="106" height="64" rx="8" fill="#f0f7ff"/>
        <text x="14" y="28" font-family="Inter, sans-serif" font-size="11" fill="#6b7280">CLIENTS</text>
        <text x="14" y="50" font-family="Inter, sans-serif" font-size="22" font-weight="700" fill="#0066cc">15+</text>

        <rect x="118" y="0" width="106" height="64" rx="8" fill="#f0f7ff"/>
        <text x="132" y="28" font-family="Inter, sans-serif" font-size="11" fill="#6b7280">YEARS</text>
        <text x="132" y="50" font-family="Inter, sans-serif" font-size="22" font-weight="700" fill="#0066cc">5+</text>

        <rect x="236" y="0" width="106" height="64" rx="8" fill="#f0f7ff"/>
        <text x="250" y="28" font-family="Inter, sans-serif" font-size="11" fill="#6b7280">SECTORS</text>
        <text x="250" y="50" font-family="Inter, sans-serif" font-size="22" font-weight="700" fill="#0066cc">9</text>
      </g>

      <!-- Bar chart -->
      <g transform="translate(20, 144)">
        <text x="0" y="0" font-family="Inter, sans-serif" font-size="10" fill="#6b7280">REVENUE / Q</text>
        <line x1="0" y1="118" x2="160" y2="118" stroke="#e5e7eb" stroke-width="1"/>
        <rect x="8" y="80" width="20" height="38" rx="2" fill="url(#barGrad)" opacity="0.55"/>
        <rect x="38" y="60" width="20" height="58" rx="2" fill="url(#barGrad)" opacity="0.7"/>
        <rect x="68" y="40" width="20" height="78" rx="2" fill="url(#barGrad)" opacity="0.85"/>
        <rect x="98" y="50" width="20" height="68" rx="2" fill="url(#barGrad)"/>
        <rect x="128" y="20" width="20" height="98" rx="2" fill="url(#barGrad)"/>
      </g>

      <!-- Line chart -->
      <g transform="translate(200, 144)">
        <text x="0" y="0" font-family="Inter, sans-serif" font-size="10" fill="#6b7280">TREND</text>
        <line x1="0" y1="118" x2="160" y2="118" stroke="#e5e7eb" stroke-width="1"/>
        <line x1="0" y1="78" x2="160" y2="78" stroke="#e5e7eb" stroke-width="1" stroke-dasharray="2,3"/>
        <line x1="0" y1="38" x2="160" y2="38" stroke="#e5e7eb" stroke-width="1" stroke-dasharray="2,3"/>

        <!-- Filled area under line -->
        <path d="M 4 90 L 36 70 L 68 50 L 100 60 L 132 30 L 156 42 L 156 118 L 4 118 Z"
              fill="#0066cc" opacity="0.1"/>
        <!-- Line stroke -->
        <polyline points="4,90 36,70 68,50 100,60 132,30 156,42"
                  fill="none" stroke="#0066cc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- Data points -->
        <circle cx="4" cy="90" r="3" fill="#fff" stroke="#0066cc" stroke-width="2"/>
        <circle cx="36" cy="70" r="3" fill="#fff" stroke="#0066cc" stroke-width="2"/>
        <circle cx="68" cy="50" r="3" fill="#fff" stroke="#0066cc" stroke-width="2"/>
        <circle cx="100" cy="60" r="3" fill="#fff" stroke="#0066cc" stroke-width="2"/>
        <circle cx="132" cy="30" r="4" fill="#0066cc"/>
        <circle cx="156" cy="42" r="3" fill="#fff" stroke="#0066cc" stroke-width="2"/>
      </g>
    </g>

    <!-- Floating side card (data flow) -->
    <g transform="translate(335, 250)">
      <rect x="0" y="0" width="100" height="76" rx="10" fill="#ffffff" stroke="#e5e7eb" stroke-width="1.5"/>
      <text x="12" y="20" font-family="Inter, sans-serif" font-size="9" fill="#6b7280">PIPELINE</text>
      <circle cx="20" cy="42" r="6" fill="#0066cc"/>
      <line x1="26" y1="42" x2="44" y2="42" stroke="#0066cc" stroke-width="1.5"/>
      <circle cx="50" cy="42" r="6" fill="#0066cc" opacity="0.7"/>
      <line x1="56" y1="42" x2="74" y2="42" stroke="#0066cc" stroke-width="1.5"/>
      <circle cx="80" cy="42" r="6" fill="#0066cc" opacity="0.4"/>
      <rect x="12" y="58" width="76" height="6" rx="2" fill="#e5e7eb"/>
      <rect x="12" y="58" width="50" height="6" rx="2" fill="#0066cc" opacity="0.5"/>
    </g>
  </svg>
</div>
