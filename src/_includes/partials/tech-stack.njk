{% set s = strings[lang] %}
<section class="section">
  <div class="container">
    <div class="section-title">
      <h2>{{ s.home.techTitle }}</h2>
      <p>{{ s.home.techSubtitle }}</p>
    </div>

    <div class="tech-grid">
      <div class="tech-item">
        <img src="https://api.iconify.design/logos:sap.svg" alt="SAP" loading="lazy" width="40" height="40">
        <span>SAP</span>
      </div>
      <div class="tech-item">
        <img src="https://api.iconify.design/logos:microsoft-power-bi.svg" alt="Power BI" loading="lazy" width="40" height="40">
        <span>Power BI</span>
      </div>
      <div class="tech-item">
        <img src="https://api.iconify.design/logos:microsoft-azure.svg" alt="Azure" loading="lazy" width="40" height="40">
        <span>Azure Synapse</span>
      </div>
      <div class="tech-item">
        <img src="https://api.iconify.design/logos:snowflake-icon.svg" alt="Snowflake" loading="lazy" width="40" height="40">
        <span>Snowflake</span>
      </div>
      <div class="tech-item">
        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/microsoftsqlserver/microsoftsqlserver-original.svg" alt="MSSQL Server" loading="lazy" width="40" height="40">
        <span>MSSQL Server</span>
      </div>
      <div class="tech-item">
        <img src="https://api.iconify.design/logos:postgresql.svg" alt="PostgreSQL" loading="lazy" width="40" height="40">
        <span>PostgreSQL</span>
      </div>
      <div class="tech-item">
        <img src="https://api.iconify.design/logos:tableau-icon.svg" alt="Tableau" loading="lazy" width="40" height="40">
        <span>Tableau</span>
      </div>
      <div class="tech-item">
        <img src="https://api.iconify.design/logos:python.svg" alt="Python" loading="lazy" width="40" height="40">
        <span>Python</span>
      </div>
    </div>

    <div class="tech-detail">
      <p><strong>{{ s.home.techSapLabel }}:</strong> BW · BO/WEBI · Datasphere · HANA · SAC · Data Services</p>
      <p><strong>{{ s.home.techMsLabel }}:</strong> Power BI · Fabric · Azure Synapse · MSSQL · DAX · Power Query</p>
      <p><strong>{{ s.home.techOtherLabel }}:</strong> Snowflake · Tableau · PostgreSQL · Python</p>
    </div>
  </div>
</section>
