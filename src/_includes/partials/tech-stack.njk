{% set s = strings[lang] %}
<section class="section">
  <div class="container">
    <div class="section-title">
      <h2>{{ s.home.techTitle }}</h2>
      <p>{{ s.home.techSubtitle }}</p>
    </div>

    <div class="tech-grid">
      <div class="tech-item">
        <img src="https://cdn.simpleicons.org/sap" alt="SAP" loading="lazy" width="36" height="36">
        <span>SAP</span>
      </div>
      <div class="tech-item">
        <img src="https://cdn.simpleicons.org/powerbi" alt="Power BI" loading="lazy" width="36" height="36">
        <span>Power BI</span>
      </div>
      <div class="tech-item">
        <img src="https://cdn.simpleicons.org/microsoftazure" alt="Microsoft Azure" loading="lazy" width="36" height="36">
        <span>Azure Synapse</span>
      </div>
      <div class="tech-item">
        <img src="https://cdn.simpleicons.org/snowflake" alt="Snowflake" loading="lazy" width="36" height="36">
        <span>Snowflake</span>
      </div>
      <div class="tech-item">
        <img src="https://cdn.simpleicons.org/microsoftsqlserver" alt="MSSQL Server" loading="lazy" width="36" height="36">
        <span>MSSQL Server</span>
      </div>
      <div class="tech-item">
        <img src="https://cdn.simpleicons.org/postgresql" alt="PostgreSQL" loading="lazy" width="36" height="36">
        <span>PostgreSQL</span>
      </div>
      <div class="tech-item">
        <img src="https://cdn.simpleicons.org/tableau" alt="Tableau" loading="lazy" width="36" height="36">
        <span>Tableau</span>
      </div>
      <div class="tech-item">
        <img src="https://cdn.simpleicons.org/python" alt="Python" loading="lazy" width="36" height="36">
        <span>Python</span>
      </div>
    </div>

    <div class="tech-detail">
      <p><strong>{{ s.home.techSapLabel }}:</strong> BW · BO/WEBI · Datasphere · HANA · SAC · Data Services</p>
      <p><strong>{{ s.home.techMsLabel }}:</strong> Power BI · Fabric · Azure Synapse · MSSQL · DAX · Power Query</p>
      <p><strong>{{ s.home.techOtherLabel }}:</strong> Snowflake · Tableau · PostgreSQL · Python</p>
    </div>
  </div>
</section>
