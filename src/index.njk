<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Enes Şaşmaz</title>
<script>
(function() {
  var lang = (navigator.language || 'tr').toLowerCase();
  var target = lang.indexOf('tr') === 0 ? '/tr/' : '/en/';
  window.location.replace(target);
})();
</script>
<meta http-equiv="refresh" content="0; url=/tr/">
</head>
<body>
<p>Redirecting to <a href="/tr/">Türkçe</a> / <a href="/en/">English</a>...</p>
</body>
</html>
